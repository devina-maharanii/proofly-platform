{
  "name": "proofly-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "NODE_ENV=production next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "pnpm typecheck",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:a11y": "playwright test",
    "lighthouse:home": "lighthouse http://127.0.0.1:3101 --only-categories=performance,accessibility,best-practices,seo --output=json --output-path=.reports/lighthouse-home.json --chrome-flags=\"--headless=new --no-sandbox\"",
    "format": "prettier --write app components lib tests e2e proxy.ts playwright.config.ts vitest.config.ts package.json tsconfig.json next.config.ts postcss.config.mjs eslint.config.mjs ideas.md",
    "format:check": "prettier --check app components lib tests e2e proxy.ts playwright.config.ts vitest.config.ts package.json tsconfig.json next.config.ts postcss.config.mjs eslint.config.mjs ideas.md"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.5",
    "@supabase/supabase-js": "2.112.4",
    "lucide-react": "1.34.0",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.2",
    "lighthouse": "13.4.1",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
